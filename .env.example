# Claude APIキー(任意、精度向上用)
# 設定すると、地図データの候補をWeb検索で検証・補正し(誤タグ付けの修正、実際の
# 移動時間確認)、さらに週末限定イベントを別途1件探して提案に追加する。
# 未設定時は地図データ(OpenStreetMap)のみでの提案になる(TAVILY_API_KEYがあれば
# イベント情報のみ簡易検索する)。
ANTHROPIC_API_KEY=

# 子供向けイベント情報の検索用(Tavily、無料枠あり・任意)
# https://app.tavily.com/ で登録して取得。ANTHROPIC_API_KEY未設定時のみ使われる
TAVILY_API_KEY=

# メール送信用SMTP設定(Gmailの場合はアプリパスワードを使用)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 検索の中心地点(未設定時は横浜市都筑区川向町の座標を使用)
HOME_LAT=35.5165
HOME_LON=139.5890
HOME_LABEL=横浜市都筑区川向町
