# Claude APIキー(お出かけ先のWeb検索・提案生成に使用)
ANTHROPIC_API_KEY=

# メール送信用SMTP設定(Gmailの場合はアプリパスワードを使用)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 検索の中心地点(未設定時は横浜市都筑区川向町の座標を使用)
HOME_LAT=35.5165
HOME_LON=139.5890
HOME_LABEL=横浜市都筑区川向町

# ダッシュボードの公開URL(メール本文のリンクに使用)
DASHBOARD_URL=https://<github-username>.github.io/<repo>/
