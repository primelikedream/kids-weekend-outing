# 子供向けイベント情報の検索用(Tavily、無料枠あり・任意)
# https://app.tavily.com/ で登録して取得。未設定でもイベント検索をスキップして動作する
TAVILY_API_KEY=

# メール送信用SMTP設定(Gmailの場合はアプリパスワードを使用)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# 検索の中心地点(未設定時は横浜市都筑区川向町の座標を使用)
HOME_LAT=35.5165
HOME_LON=139.5890
HOME_LABEL=横浜市都筑区川向町
